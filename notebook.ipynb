    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Dane do wykresu\n",
    "x = [1, 2, 3, 4, 5]\n",
    "y = [2, 4, 6, 8, 10]\n",
    "\n",
    "# Tworzenie wykresu\n",
    "plt.plot(x, y)\n",
    "\n",
    "# Opisy\n",
    "plt.title(\"Prosty wykres\")\n",
    "plt.xlabel(\"Oś X\")\n",
    "plt.ylabel(\"Oś Y\")\n",
    "\n",
    "# Wyświetlenie\n",
    "plt.show()"
   ]
  }
